{
  "name": "fullstack-demo",
  "description": "Frontend + backend, runnable with one command and no Docker required",
  "services": {
    "api": {
      "plugin": "node-service",
      "config": {
        "cwd": "../examples/demo-app/backend",
        "command": "node server.js",
        "port": 4000
      }
    },
    "web": {
      "plugin": "static-frontend",
      "config": {
        "root": "../examples/demo-app/frontend",
        "port": 8080
      },
      "dependsOn": ["api"]
    }
  }
}
