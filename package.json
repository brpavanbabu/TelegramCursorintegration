{
  "name": "telegram-cursor-integration",
  "version": "1.0.0",
  "description": "Control Cursor IDE from Telegram with full context preservation and automated execution",
  "main": "telegram-cursor-bot.js",
  "scripts": {
    "start": "node telegram-cursor-bot.js",
    "install-bot": "node install.js",
    "setup": "node setup.js",
    "test": "node testframework/cli.js all",
    "test:unit": "node testframework/cli.js run",
    "test:security": "node testframework/cli.js analyze --strict",
    "test:fuzz": "node testframework/cli.js generate",
    "test:requirements": "node testframework/cli.js matrix",
    "test:discover": "node testframework/cli.js discover",
    "test:report": "node testframework/cli.js all --json --junit --html"
  },
  "keywords": [
    "telegram",
    "cursor",
    "ide",
    "automation",
    "bot",
    "ai",
    "integration"
  ],
  "author": "Pavan Babu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brpavanbabu/telegram-cursor-integration.git"
  },
  "bugs": {
    "url": "https://github.com/brpavanbabu/telegram-cursor-integration/issues"
  },
  "homepage": "https://github.com/brpavanbabu/telegram-cursor-integration#readme",
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "robotjs": "^0.6.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
